# Copy to .env.local for local overrides. Everything is optional for local dev:
# with no DATABASE_URL, `npm run dev` uses an embedded Postgres in .data/pglite.

# Postgres connection string (Neon via the Vercel Marketplace sets this automatically).
# Use the *pooled* connection string on Vercel.
DATABASE_URL=

# Required in production. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Optional. Pin auth to one origin (e.g. https://sccsc.org). When unset, the current Vercel
# deployment/branch/production hosts are trusted automatically.
BETTER_AUTH_URL=
# Extra hostnames to trust for auth (comma-separated), e.g. sccsc.org,www.sccsc.org
AUTH_ALLOWED_HOSTS=

# Canonical site URL used for metadata/sitemap.
NEXT_PUBLIC_SITE_URL=https://sccsc.org

# Leave unset for previews: shows the "preview" banner and blocks search indexing.
# Set to "true" only when this becomes the real sccsc.org.
NEXT_PUBLIC_SITE_LIVE=
