# Public, non-secret production settings (committed on purpose: they're readable by browsers
# anyway). Values set in Vercel's Environment Variables take precedence over these.
# Secrets such as DATABASE_URL and BETTER_AUTH_SECRET never go in this file.

# The site is live on sccsc.org: allow search engines and use the real domain in links and feeds.
NEXT_PUBLIC_SITE_LIVE=true
NEXT_PUBLIC_SITE_URL=https://sccsc.org
